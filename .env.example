# Gere uma chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Para desenvolvimento local, SQLite é criado automaticamente em ./data.
# Em produção, use a URL PostgreSQL fornecida pelo Render ou Supabase.
DATABASE_URL=sqlite:///./data/extractions.db
MAX_INPUT_CHARS=30000
APP_ENV=development
